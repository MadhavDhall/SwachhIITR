# Render PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database

# Cloudinary server-side credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=wasteos/scans

# Public URL used by the browser when the API is on another service
NEXT_PUBLIC_API_URL=

# Optional public FastAPI service URL for real YOLO/OR-Tools calls
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# FastAPI runtime
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
YOLO_MODEL_PATH=models/yolov8n_waste.pt

# Optional key for future manual telemetry integrations
INGESTION_API_KEY=
