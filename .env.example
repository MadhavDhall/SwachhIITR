# Render PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database

# Cloudinary server-side credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=wasteos/scans

# Public URL used by the browser when the API is on another service
NEXT_PUBLIC_API_URL=

# Optional public FastAPI service URL for real YOLO/OR-Tools calls
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# FastAPI runtime
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
YOLO_MODEL_PATH=models/yolov8n_waste.pt

# MQTT broker (HiveMQ Cloud, EMQX Cloud, or AWS IoT Core)
MQTT_BROKER=
MQTT_PORT=8883
MQTT_TOPIC=wasteos/sensors/+/data
MQTT_TLS=true
MQTT_CLIENT_ID=wasteos-api
MQTT_USERNAME=
MQTT_PASSWORD=
# Required for certificate-based brokers such as AWS IoT Core
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
INGESTION_API_KEY=
